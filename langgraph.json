{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    ".",
    "langchain>=0.3.9",
    "langchain-ollama>=0.1.0"
  ],
  "graphs": {
    "tools_Assistant": "./src/agents/agent.py:tools_Assistant",
    "Intelligent_Assistant": "./src/agents/agent.py:Intelligent_Assistant",
    "intelligent_deep_agent": "./src/deep_agents/agents/intelligent_local.py:create_intelligent_deep_agent",
    "chat_agent": "./src/deep_agents/agents/collaborative_agents.py:create_chat_agent",
    "coordinator_agent": "./src/deep_agents/agents/collaborative_agents.py:create_coordinator_agent",
    "coder_agent": "./src/deep_agents/agents/collaborative_agents.py:create_coder_agent",
    "researcher_agent": "./src/deep_agents/agents/collaborative_agents.py:create_researcher_agent",
    "assistant_agent": "./src/deep_agents/agents/collaborative_agents.py:create_assistant_agent"
  },
  "env": ".env",
  "checkpointer": {
    "type": "postgres",
    "connection_string": "LANGGRAPH_POSTGRES_URI"
  },
  "watch": {
    "exclude": [
      ".langgraph_api/**",
      "logs/**",
      "workspace/**",
      "threads.json",
      "*.pckl",
      "*.jsonl"
    ]
  }
}
