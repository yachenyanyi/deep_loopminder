{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    ".",
    "langchain>=0.3.9",
    "langchain-ollama>=0.1.0"
  ],
  "graphs": {
    "acp_worker": "src.deep_agents.agents.pm_agent.server:acp_worker",
    "acp_control": "src.middlewares.acp.server:acp_control",
    "pm_agent": "./src/deep_agents/agents/pm_agent/agent.py:pm_agent_server",
    "pm_memory_agent": "src.middlewares.memory.pm_agent_memory.graph:pm_memory_agent_server"
  },
  "env": ".env",
  "store": {
    "path": "src.middlewares.persistence.pm_runtime.generate_pm_store"
  },
  "http": {
    "app": "src.deep_agents.agents.pm_agent.server:app"
  },
  "checkpointer": {
    "path": "src.middlewares.persistence.pm_runtime.generate_pm_checkpointer"
  },
  "watch": {
    "exclude": [
      ".langgraph_api/**",
      "logs/**",
      "workspace/**",
      "threads.json",
      "*.pckl",
      "*.jsonl"
    ]
  }
}
