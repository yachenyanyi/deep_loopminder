# DeepLoopMinder 环境变量模板
# 将本文件复制为项目根目录的 .env，然后按需填写。
# .env 已被 Git 忽略；本模板不包含真实密钥。
# 可选地址保持注释，避免空字符串覆盖代码或 SDK 的默认行为。

# ── 默认模型 ────────────────────────────────────────────────
# 真实运行与测试统一使用 minimax/minimax-m3.1-flash:free，单次输出上限32768。
# 必须配置OPEN_ROUTER_API_KEY（也兼容OPENROUTER_API_KEY）；缺少密钥明确失败。
# 下方其他供应商仅保留显式工厂入口，默认模型不会自动调用。
CLAUDE_CODE_MAX_OUTPUT_TOKENS=32768

# 可选显式入口：Command Code GOAT，复用 LangChain 官方 ChatOpenAI。
# 仅直接调用get_command_goat_model时使用，不影响默认免费路由。
# 模型需支持 /chat/completions；可用模型与接口以官网 /provider/v1/models 为准。
# 官方文档：https://commandcode.ai/docs/provider
# 与现有 .env 的变量名保持一致；COMMAND_CODE_API_KEY 也可使用。
COMMADN_GOAT_API_KEY=
COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMAND_CODE_MODEL=meta/muse-spark-1.3-contributor
# 主 Agent 的思考等级：low / medium / high / xhigh。
COMMAND_CODE_REASONING_EFFORT=medium
# 单次输出预算包含推理 token；该模型的输出上限为 32768。
COMMAND_CODE_MAX_TOKENS=32768
# PM 消息历史达到约 300K token 时，先生成交接，再调用官方摘要。
PM_COMPACTION_TOKEN_THRESHOLD=300000
# PM 请求上下文预算包含系统提示词、消息与工具描述，使用官方近似 token 计数。
# 超过预算时先保留交接，再使用官方 trim_messages 控制本次模型输入；模型物理容量仍为 1048576。
PM_CONTEXT_TOKEN_LIMIT=500000

# 可选显式入口：Anthropic 协议接口。下面为该入口的默认值。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash

# 默认入口：OpenRouter免费路由，模型与输出预算由src/models/llm.py统一定义。
OPEN_ROUTER_API_KEY=

# ── PostgreSQL / PM Memory ──────────────────────────────────
# 保存项目状态、记忆及项目自建的 checkpoint。
# 以下仅为本机示例：替换用户名、密码、主机、端口及数据库名称。
# 密码中的 @、:、/、# 等字符需做 URL 编码。
# 数据库需预先创建；现有初始化链连接失败时会回退内存，无法跨进程持久保存。
LANGGRAPH_POSTGRES_URI=postgresql://postgres:change_me@localhost:5432/deep_loopminder

# 文件系统模块优先读取 DATABASE_URL；未设置时复用上面的 PostgreSQL 地址。
# DATABASE_URL=postgresql://postgres:change_me@localhost:5432/deep_loopminder

# 缓存默认复用 LANGGRAPH_POSTGRES_URI；单独使用数据库时再设置。
# CACHE_DB_URI=postgresql://postgres:change_me@localhost:5432/deep_loopminder

# ── 官方 Agent Server / 后台记忆 ────────────────────────────
# PM 后台记忆需要运行 LangGraph Agent Server。
# langgraph.json 的 store.path 将 Server 与图工厂绑定到同一官方 Store。
# 配置 PostgreSQL 时复用 PostgresStore 的异步接口，兼容 Windows 后台循环。
# 同部署调用：不要设置 LANGGRAPH_API_URL，官方 SDK 使用进程内 ASGI。
# 从独立进程连接本机服务或连接远程部署时，取消下一行注释并修改地址。
# LANGGRAPH_API_URL=http://localhost:2024

# 需要 API Key 的部署才填写；官方 SDK 会自动读取。
# LANGGRAPH_API_KEY=
# LANGSMITH_API_KEY=

# 可选：LangSmith 链路追踪；启用时同时填写 LANGSMITH_API_KEY。
LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=deep-loopminder
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 其他模型接口（按需填写） ────────────────────────────────
# 这些 Key 用于各自的模型函数，单独填写不会改变上面的默认模型选择顺序。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GOOGLE_API_KEY=
DOUBAO_API_KEY=
ZHIPUAI_API_KEY=

# ── MCP 工具 ────────────────────────────────────────────────
# 必须是合法 JSON；当前加载器要求每个服务都包含 transport 和 http(s) url。
# 不使用 MCP 时保留空对象。示例地址只是占位，不会启动 MCP 服务。
MCP_CONFIG='{}'
# MCP_CONFIG='{"my_server":{"transport":"streamable_http","url":"http://localhost:8000/mcp"}}'

# ── 教学 Agent 的可选服务 ────────────────────────────────────
# Bilibili 登录 Cookie，用于访问需要登录的字幕等资源。
BILIBILI_COOKIE=

# 学习路线图 / 测验：按实际部署填写 Node 后端地址及双方一致的内部认证密钥。
# NODE_INTERNAL_URL=http://localhost:3000
INTERNAL_SECRET=

# 错题本 API。未设置时使用模块中的默认地址。
# ERROR_BOOK_API_URL=https://your-backend.example.com

# ── 外部 Codex / Claude ACP（可选） ──────────────────────────
# 默认沿用本机原生登录，不需要在这里保存登录令牌。
# 使用已有 Codex 可执行文件时，可配置上游适配器支持的 CODEX_PATH。
# Windows 路径推荐使用 /。
# CODEX_PATH=C:/path/to/codex.exe

# 中间件角色配置；空数组保持 PM 原有装配。同部署省略 url。
ACP_SUBAGENTS_JSON=[]
# ACP_SUBAGENTS_JSON='[{"name":"researcher","description":"只读调查项目","graph_id":"acp_worker"}]'
# SDK 连接只由部署方配置；启动命令、目录、角色与 grants 的示例见 src/middlewares/acp/README.md。
ACP_WORKERS_JSON=[]
# 固定分工：Claude Code 负责 developer；Codex 负责 reviewer、tester、researcher。
# Codex 默认 gpt-6-luna；Claude 保持 MiniMax 免费模型；不修改 PM 主模型或用户全局配置。
# npm install --prefix .local-acp --save-exact @agentclientprotocol/codex-acp@2.2.2 @agentclientprotocol/claude-agent-acp@0.94.0
# 将项目和 Claude 可执行文件路径换成实际路径。角色归属互不重叠，不靠提供方排序决定分工。
# ACP_SUBAGENTS_JSON='[{"name":"developer","description":"负责开发、修复和开发自测；Claude Code可使用原生子代理自主拆分工作，具体工具取决于部署。技术方案由其决定，通过会话用中文交接成果，不继承PM项目状态、记忆或制品工具，不访问宿主Store。","graph_id":"acp_worker"},{"name":"researcher","description":"负责研究、调查、资料检索和信息搜集，引用来源并区分事实、推断和未知；不承接产品功能开发。","graph_id":"acp_worker"},{"name":"reviewer","description":"负责对照既定需求和验收标准核验交付物，报告证据、问题与未知项；发现开发缺陷交回 developer，不自行宣称人工批准。","graph_id":"acp_worker"},{"name":"tester","description":"负责执行必要测试、复现问题和记录测试结果；发现产品缺陷交回 developer 修复，不承接产品功能开发。","graph_id":"acp_worker"}]'
# ACP_WORKERS_JSON='[{"provider_id":"codex","roles":["reviewer","tester","researcher"],"capabilities":["repo.read","repo.write","files.read","files.write","shell.execute","test.execute","web.search"],"command":["node","D:/deep_loopminder/.local-acp/node_modules/@agentclientprotocol/codex-acp/dist/index.js"],"cwd":"D:/deep_loopminder","env":{"CODEX_CONFIG":"{\"model\":\"gpt-6-luna\"}","INITIAL_AGENT_MODE":"workspace-write"},"timeout":300,"grants":["worker.connect","worker.new","worker.ask","worker.cancel","worker.resume","worker.observe","worker.steer","external_tool.read","external_tool.search","external_tool.edit","external_tool.execute","external_tool.fetch"],"approval":{"use":"src.middlewares.approval.builtin:YamlPolicyProvider","config":{}}},{"provider_id":"claude","roles":["developer"],"capabilities":["repo.read","repo.write","files.read","files.write","shell.execute","test.execute","web.search"],"command":["node","D:/deep_loopminder/.local-acp/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js"],"cwd":"D:/deep_loopminder","env":{"CLAUDE_CODE_EXECUTABLE":"C:/path/to/claude.exe","ANTHROPIC_MODEL":"minimax/minimax-m3.1-flash:free","ANTHROPIC_DEFAULT_OPUS_MODEL":"minimax/minimax-m3.1-flash:free","ANTHROPIC_DEFAULT_SONNET_MODEL":"minimax/minimax-m3.1-flash:free","ANTHROPIC_DEFAULT_HAIKU_MODEL":"minimax/minimax-m3.1-flash:free","CLAUDE_CODE_MAX_OUTPUT_TOKENS":"32768","DISABLE_AUTOUPDATER":"1"},"timeout":300,"grants":["worker.connect","worker.new","worker.ask","worker.cancel","worker.resume","worker.observe","worker.steer","external_tool.read","external_tool.search","external_tool.edit","external_tool.execute","external_tool.fetch"],"approval":{"use":"src.middlewares.approval.builtin:YamlPolicyProvider","config":{}}}]'
# Windows 启动官方 Agent Server 前在终端设置 $env:PYTHONUTF8 = '1'。
